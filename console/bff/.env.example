LIFECYCLE_API_BASE=http://127.0.0.1:8090/v1
TENANTS_TOML_PATH=/path/to/tenants.toml
BFF_SESSION_SECRET=change-me-to-a-long-random-string
BFF_ADMIN_TOKEN=change-me-admin-token
BFF_COOKIE_SECURE=false
BFF_CORS_ORIGINS=http://localhost:5173
BFF_AGGREGATE_CACHE_SECONDS=0
BFF_HTTP_TIMEOUT_SECONDS=30

# Optional node-agent (cluster deploy)
# BFF_K8S_PROBE_ENABLED=true
# BFF_K8S_INSECURE_SKIP_TLS_VERIFY=true
# BFF_NODEAGENT_ARCHIVE_ENABLED=true
# BFF_NODEAGENT_CLUSTER_ID=dev-cluster
# BFF_NODEAGENT_OSS_ENDPOINT=
# BFF_NODEAGENT_OSS_BUCKET=
# BFF_NODEAGENT_OSS_KEY_PREFIX=logs
# BFF_NODEAGENT_OSS_ACCESS_KEY_ID=
# BFF_NODEAGENT_OSS_ACCESS_KEY_SECRET=
