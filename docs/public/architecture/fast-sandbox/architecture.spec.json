  "cards": [
    {
      "dot": "cyan",
      "title": "Control plane & access",
      "items": [
        "Control plane: Helm Deployments; FastPath co-hosts Reconciler + gRPC :9090",
        "Create persists a Sandbox CRD intent, then Top-K selects a Fastlet",
        "ResolveEndpoint signs Ed25519 route credentials for ingress",
        "Server DB: template catalog + snapshot metadata"
      ]
    },
    {
      "dot": "emerald",
      "title": "Template artifact flow",
      "items": [
        "FastPath reconciles SandboxTemplate CR → privileged builder Pod (KVM)",
        "Golden set: rootfs.ext4 + vmstate + memory + manifest + SHA256SUMS",
        "S3 digest16(manifest) namespace; index (template ID) written last"
      ]
    },
    {
      "dot": "amber",
      "title": "Storage acceleration & checkpoints",
      "items": [
        "Hot path: XFS reflink clone from node cache; LoadSnapshot restore only",
        "Cold path: agent pulls whole files via P2P cache or direct S3; sha256 + atomic commit",
        "P2P cache-miss → origin S3 (presigned GET); block transfer on :9000 (DNS dart:9000)",
        "Agent fallback: direct SigV4 S3 pull/publish when P2P cache is down",
        "Resume: placement prefers same Fastlet; cross-node pulls checkpoint by digest",
        "Pause: reflink before pause; digest-first ManifestRef+Digest; then release"
      ]
    }
  ]
}