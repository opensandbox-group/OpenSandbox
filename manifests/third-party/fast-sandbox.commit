# Pinned fast-sandbox source, Git-LFS-pointer style: a tiny text file that
# names the exact upstream commit the OpenSandbox repo builds against.
#
# Two derived artifacts must stay in sync with this commit:
#   - the companion images built by manifests/release/build-fast-sandbox.sh
#     (fsb-controller, fsb-fastlet, fsb-fastlet-proxy, fsb-janitor,
#     fsb-firecracker-runtime, fsb-sandboxtemplate-builder — Firecracker scope
#     only; boxlite and the sandbox-action-fixture are never built)
#   - the CRD bundle vendored at manifests/charts/base/files/fast-sandbox-crds.yaml
#
# Bump by updating `commit` to a full 40-character SHA, then run:
#   manifests/release/build-fast-sandbox.sh --sync-crds
repo: https://github.com/opensandbox-group/fast-sandbox.git
commit: fb87a538e8ebef2bdf2da79ac10aa4eb9647993c
