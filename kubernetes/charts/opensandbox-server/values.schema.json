                        "providerType": {
                            "type": "string"
                        },
                        "replicaCount": {
                            "type": "integer"
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "anyOf": [{"type": "string"}, {"type": "number"}]
                                        },
                                        "memory": {
                                            "anyOf": [{"type": "string"}, {"type": "number"}]
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "anyOf": [{"type": "string"}, {"type": "number"}]
                                        },
                                        "memory": {
                                            "anyOf": [{"type": "string"}, {"type": "number"}]
                                        }
                                    }
                                }
                            }
                        },
                        "secureAccess": {
                            "type": "object",
                            "properties": {
                                "activeKey": {
                                    "type": "string"
                                },
                                "keys": {
                                    "type": "array"
                                }
                            }
                        }
                    }
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "replicaCount": {
                    "type": "integer"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "anyOf": [{"type": "string"}, {"type": "number"}]
                                },
                                "memory": {
                                    "anyOf": [{"type": "string"}, {"type": "number"}]
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "anyOf": [{"type": "string"}, {"type": "number"}]
                                },
                                "memory": {
                                    "anyOf": [{"type": "string"}, {"type": "number"}]
                                }
                            }
                        }
                    }
                },
                "tolerations": {
                    "type": "array"
                },
                "volumeMounts": {
                    "type": "array"
                },
                "volumes": {
                    "type": "array"
                }
            }
        }
    }
}
