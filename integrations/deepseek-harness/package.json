{
  "name": "@opensandbox/deepseek-harness",
  "version": "0.1.0",
  "description": "Remote-only DeepSeek Harness providers for OpenSandbox",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./binding": { "types": "./dist/binding.d.ts", "import": "./dist/binding.js" },
    "./sdk-transport": { "types": "./dist/sdk-transport.d.ts", "import": "./dist/sdk-transport.js" },
    "./shell": { "types": "./dist/shell.d.ts", "import": "./dist/shell.js" },
    "./filesystem": { "types": "./dist/filesystem.d.ts", "import": "./dist/filesystem.js" },
    "./headless": { "types": "./dist/headless.d.ts", "import": "./dist/headless.js" }
  },
  "files": ["dist", "remote/fs_helper.py"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:helper": "python3 -m unittest discover -s tests -p '*_test.py' -v",
    "pack:check": "pnpm run build && node scripts/pack-check.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.0",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell-env": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
