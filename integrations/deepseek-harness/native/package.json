{
  "name": "@opensandbox/deepseek-harness-native",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness OpenSandbox session preset for the npm CLI Web profile",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "examples/opensandbox-web.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --check",
    "test": "node scripts/stage.mjs && vitest run --config vitest.config.ts",
    "pack:check": "pnpm run build && node scripts/pack-check.mjs",
    "test:profile": "pnpm run build && node scripts/profile-check.mjs",
    "prepack": "pnpm run build",
    "test:browser": "pnpm run build && node scripts/browser-test.mjs"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell-env": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell-env": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "24.10.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "yaml": "2.8.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1"
  }
}
